{
  "name": "apitestlab",
  "version": "2.0.0",
  "description": "Self-hosted API experimentation, testing, and performance platform",
  "type": "module",
  "main": "index.js",
  "bin": {
    "apitestlab": "bin/cli.js"
  },
  "files": [
    "bin",
    "backend/src",
    "!backend/src/.env",
    "backend/tests",
    "backend/manager.js",
    "backend/documentation.js",
    "frontend/*.html",
    "frontend/css",
    "frontend/js",
    "frontend/docs",
    "index.js"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "dev": "nodemon backend/src/server.js",
    "build:embed": "node scripts/generate-frontend-embed.js",
    "build:exe": "node scripts/build-exe.js --target=win",
    "build:linux": "node scripts/build-exe.js --target=linux",
    "build:macos": "node scripts/build-exe.js --target=macos",
    "build:all": "node scripts/build-exe.js --target=all",
    "package:zip": "powershell -ExecutionPolicy Bypass -File scripts/create-zips.ps1",
    "package:exe": "pkg --sea . --targets node20-win-x64 --output dist/apitestlab.exe",
    "package:linux": "pkg --sea . --targets node20-linux-x64 --output dist/apitestlab-linux",
    "package:all": "pkg --sea . --targets node20-win-x64,node20-linux-x64,node20-macos-x64 --out-path dist"
  },
  "keywords": [
    "api",
    "testing",
    "load-testing",
    "concurrency",
    "http",
    "developer-tools"
  ],
  "author": "feznaseer",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mime-types": "^3.0.2",
    "multer": "^2.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.25.0",
    "esbuild": "^0.28.2"
  },
  "pkg": {
    "scripts": [
      "backend/**/*.js",
      "bin/**/*.js"
    ],
    "assets": [
      "frontend/**/*"
    ],
    "ignore": [
      ".env",
      ".env.*",
      "backend/src/.env",
      "uploads/**",
      "logs/**",
      "*.log"
    ]
  }
}
